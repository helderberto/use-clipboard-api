{
  "name": "use-clipboard-api",
  "version": "0.3.6",
  "description": "📋useClipboardApi is a React Hook that consumes Web Clipboard API.",
  "author": "Helder B. Berto <helder.burato@gmail.com>",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.+(js|ts|tsx|json)\"",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsup",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "check:package": "publint && attw --pack ."
  },
  "keywords": [
    "react",
    "react-hook",
    "hooks",
    "hook",
    "clipboard",
    "web-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helderberto/use-clipboard-api.git"
  },
  "bugs": {
    "url": "https://github.com/helderberto/use-clipboard-api/issues"
  },
  "homepage": "https://github.com/helderberto/use-clipboard-api#readme",
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-react/eslint-plugin": "5.28.2",
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.18",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-node": "10.9.2",
    "tsup": "9.0.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix",
    "*.+(js|ts|tsx|json)": "prettier --write"
  }
}
