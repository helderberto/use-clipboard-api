{
  "name": "use-clipboard-api",
  "version": "0.3.6",
  "description": "📋useClipboardApi is a React Hook that consumes Web Clipboard API.",
  "author": "Helder B. Berto <helder.burato@gmail.com>",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"**/*.+(js|ts|tsx|json)\"",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "rm -rf ./dist && tsc",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "react-hook",
    "hooks",
    "hook",
    "clipboard",
    "web-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helderberto/use-clipboard-api"
  },
  "bugs": {
    "url": "https://github.com/helderberto/use-clipboard-api/issues"
  },
  "homepage": "https://github.com/helderberto/use-clipboard-api#readme",
  "peerDependencies": {
    "react": ">=16.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "9.39.5",
    "@swc/core": "1.16.18",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix",
    "*.+(js|ts|tsx|json)": "prettier --write"
  }
}
